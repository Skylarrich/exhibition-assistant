{
  "name": "exhibition-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "可维护源码与 GitHub Pages 发布构建流程",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/build.mjs --check",
    "format": "prettier --write src/scripts/*.js src/styles/*.css scripts/*.mjs data-source/**/*.json"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "terser": "5.39.0"
  }
}
